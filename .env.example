# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Either a postgresql:// URL or the full `psql '...'` command Neon shows.
NEON_KEY=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Public origin (Better Auth base URL and OAuth callbacks)
PUBLIC_URL=http://localhost:8080
# Required. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Optional OAuth. Callbacks: http://localhost:8080/api/auth/callback/{google,github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Seeded logins (staff: agent1/lead1/admin1/operator1@lankalink.example.lk)
SEED_STAFF_PASSWORD=Console#2026
SEED_CUSTOMER_PASSWORD=Lanka#2026

# GHCR image owner (your GitHub user) and tag
GHCR_OWNER=dsep-g22
V3_TAG=latest

# Local infra
TIMESCALE_PASSWORD=timescale
MINIO_ROOT_USER=lanka
MINIO_ROOT_PASSWORD=lanka-minio-secret

# Drafting LLM (Ollama gpt-oss). Host daemon signed in to Ollama cloud, or https://ollama.com + key
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
# Optional fallback drafting binding (Gemini, OpenAI-compatible endpoint)
GOOGLE_API_KEY=
# Groq (OpenAI-compatible): the default triage model, and an option for drafting and diagnosis
GROQ_API_KEY=

# Model implementations at boot; the admin console rebinds them live without a restart.
LANKA_LLM_IMPL=ollama
LANKA_TR_BACKEND=auto
# Cores each model service (translation, audio) may use; at most the machine's vCPU count.
MODEL_CPUS=4

# Monitoring overlay (compose.monitoring.yaml): Grafana at /grafana, user admin
GRAFANA_ADMIN_PASSWORD=

# Optional LangSmith tracing: one trace per case, every pipeline stage and the draft nested in it
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lanka-link-v3
