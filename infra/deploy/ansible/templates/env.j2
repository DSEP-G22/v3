# Written by Ansible on every deploy. Do not edit on the server: the next deploy overwrites it.
# Only what the stack reads is written here; the deploying machine's own settings stay with it.
{% macro env(name, default='') %}{{ lookup('env', name) | default(default, true) }}{% endmacro %}
NEON_KEY={{ env('NEON_KEY') }}
PUBLIC_URL=https://{{ site_domain }}
SITE_DOMAIN={{ site_domain }}
ACME_EMAIL={{ env('ACME_EMAIL') }}
BETTER_AUTH_SECRET={{ env('BETTER_AUTH_SECRET') }}

GOOGLE_CLIENT_ID={{ env('GOOGLE_CLIENT_ID') }}
GOOGLE_CLIENT_SECRET={{ env('GOOGLE_CLIENT_SECRET') }}

SEED_STAFF_PASSWORD={{ env('SEED_STAFF_PASSWORD', 'Console#2026') }}
SEED_CUSTOMER_PASSWORD={{ env('SEED_CUSTOMER_PASSWORD', 'Lanka#2026') }}

GHCR_OWNER={{ github_owner | lower }}
V3_TAG={{ v3_tag | default('latest') }}

TIMESCALE_PASSWORD={{ env('TIMESCALE_PASSWORD', 'timescale') }}
MINIO_ROOT_USER=lanka
MINIO_ROOT_PASSWORD={{ env('MINIO_ROOT_PASSWORD', 'lanka-minio-secret') }}

# No Ollama daemon on the server: the cloud endpoint with a key, else drafting falls back to Gemini.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY={{ env('OLLAMA_API_KEY') }}
GOOGLE_API_KEY={{ env('GOOGLE_API_KEY') }}

LANKA_LLM_IMPL=ollama
LANKA_TR_BACKEND=auto
# Docker refuses a CPU limit above the host's count, so the model services follow the host.
MODEL_CPUS={{ [ansible_processor_vcpus | int, 4] | min }}

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lanka-link-v3
