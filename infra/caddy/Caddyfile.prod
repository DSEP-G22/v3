# Production edge. The domain comes from the deploy (Ansible writes SITE_DOMAIN into .env),
# and Caddy gets the certificate from Let's Encrypt on first start.
{
	admin off
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /api/auth/* {
		reverse_proxy auth:3000
	}

	handle /api/* {
		reverse_proxy gateway:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

# Inside the compose network only (8080 is not published): the container health check.
:8080 {
	respond /healthz "ok" 200
}
