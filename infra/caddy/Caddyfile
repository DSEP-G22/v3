{
	admin off
	# Request counts, status codes and latency for Prometheus, served at /metrics below.
	metrics
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Local only: this block is the published one here, the internal one in production.
	handle /metrics {
		metrics
	}

	# Grafana (compose.monitoring.yaml); its own login guards it.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle /api/auth/* {
		reverse_proxy auth:3000
	}

	handle /api/* {
		reverse_proxy gateway:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
